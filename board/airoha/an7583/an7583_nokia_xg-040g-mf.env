#include <env/airoha/an758x.env>
#include <env/airoha/an758x-ubi.env>
loadaddr=0x90000000
console=earlycon=uart8250,mmio32,0x11002000 console=ttyS0
bootfile=immortalwrt-airoha-an7583-nokia_xg-040g-mf-ubi-initramfs-recovery.itb
bootfile_bl2=an7583-nokia-xg-040g-mf-preloader.bin
bootfile_fip=an7583-nokia-xg-040g-mf-bl31-u-boot.fip
bootfile_upg=immortalwrt-airoha-an7583-nokia_xg-040g-mf-ubi-squashfs-sysupgrade.itb
bootled_status=green:power
bootmenu_title=U-Boot XG-040G-MF
preboot=led $bootled_status on ; run ethaddr_factory
ethaddr_factory=run ubi_mount && ubi read 0x90000000 ri && env readmem -b ethaddr 0x9000003e 0x6
bootmenu_8=Web recovery (2.5G WAN)=setenv eth1addr $ethaddr ; setenv ethact airoha-gdm3 ; run boot_recovery ; setenv ethact ; setenv eth1addr ; run bootmenu_confirm_return
